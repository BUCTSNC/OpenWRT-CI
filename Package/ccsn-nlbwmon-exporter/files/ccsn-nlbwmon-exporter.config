config settings 'main'
	option default_network 'unknown'
	option default_traffic_class 'internet'

# client_id is derived automatically from the DHCP hostname. Devices without a
# hostname use the stable mac_<hex> fallback. Network is inferred from matching
# DHCP pool CIDRs; use default_network only as a fallback. Add DHCP pools after
# flashing.
