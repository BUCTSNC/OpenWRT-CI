config settings 'main'

# OpenWrt logical interfaces are the only network identity. Every active
# interface and its IPv4, IPv6, and DHCPv6-PD assignment prefixes are
# discovered through ubus. This works with local DHCP, static addresses,
# external DHCP, and DHCP relay. DHCP is optional; it only adds pool-capacity
# and active-lease metrics.
#
# client_id uses a locally known DHCP/static-lease hostname when available and
# otherwise falls back to mac_<hex>.
#
# nlbwmon excludes local-to-local connections. Configure all LAN, VLAN, VPN,
# and other non-Internet routed networks as nlbwmon local_network entries so
# the remaining boundary traffic is Internet traffic.
